{
	"name": "catpics",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#routes/*": "./src/routes/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types src/worker-configuration.d.ts --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types src/worker-configuration.d.ts --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types src/worker-configuration.d.ts && oxfmt --write src/worker-configuration.d.ts",
		"fmt": "oxfmt --write .",
		"db:migrate": "wrangler d1 migrations apply DB"
	},
	"dependencies": {
		"@hiseb/confetti": "^2.2.0",
		"@tanstack/svelte-virtual": "^3.13.35",
		"svelte-easy-crop": "^5.0.1"
	},
	"devDependencies": {
		"@catppuccin/daisyui": "^2.1.1",
		"@fontsource-variable/nunito": "^5.3.0",
		"@lucide/svelte": "^1.31.0",
		"@sveltejs/adapter-cloudflare": "next",
		"@sveltejs/kit": "next",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/svelte-query": "^6.1.38",
		"bits-ui": "^2.18.1",
		"daisyui": "^5.7.16",
		"kysely": "^0.29.5",
		"kysely-d1": "^0.4.0",
		"oxfmt": "^0.62.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"valibot": "^1.4.2",
		"vaul-svelte": "^0.3.2",
		"vite": "^8.0.16",
		"wrangler": "^4.97.0"
	}
}
