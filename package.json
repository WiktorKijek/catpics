{
	"name": "catpics",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#routes/*": "./src/routes/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types src/worker-configuration.d.ts --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types src/worker-configuration.d.ts --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "pnpm run build && wrangler deploy",
		"gen": "wrangler types src/worker-configuration.d.ts && oxfmt --write src/worker-configuration.d.ts",
		"fmt": "oxfmt --write .",
		"db:migrate": "wrangler d1 migrations apply DB"
	},
	"dependencies": {
		"@hiseb/confetti": "^2.2.0",
		"@tanstack/svelte-virtual": "^3.13.35",
		"svelte-easy-crop": "^5.0.1"
	},
	"devDependencies": {
		"@catppuccin/daisyui": "^2.1.1",
		"@fontsource-variable/nunito": "^5.3.0",
		"@lucide/svelte": "^1.31.0",
		"@sveltejs/adapter-cloudflare": "next",
		"@sveltejs/kit": "next",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/svelte-query": "^6.1.38",
		"bits-ui": "^2.18.1",
		"daisyui": "^5.7.17",
		"kysely": "^0.29.5",
		"kysely-d1": "^0.4.0",
		"oxfmt": "^0.63.0",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"valibot": "^1.4.2",
		"vaul-svelte": "^0.3.2",
		"vite": "^8.2.1",
		"wrangler": "^4.123.0"
	},
	"packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
